pipeline {
  agent any

  parameters {
    string(name: 'IMAGE_TAG', defaultValue: '', description: 'Docker image tag to deploy')
    string(name: 'DB_HOST', defaultValue: '10.0.2.234', description: 'PostgreSQL host reachable from Application EC2')
    string(name: 'DB_NAME', defaultValue: 'todo_dev', description: 'Database name for dev')
    string(name: 'BACKEND_PORT', defaultValue: '5000', description: 'Host port for the backend container')
    string(name: 'FRONTEND_PORT', defaultValue: '3000', description: 'Host port for the frontend container')
    string(name: 'NEXT_PUBLIC_API_URL', defaultValue: 'http://127.0.0.1:5000/api', description: 'Frontend API URL')
  }

  environment {
    DOCKER_BUILDKIT = '0'
  }

  stages {
    stage('Checkout') {
      steps {
        deleteDir()
        checkout scm

        dir('backend') {
          git branch: 'master', url: 'https://github.com/buiminh-afk/devops-bootcamp-todolist-backend-api.git'
        }

        dir('frontend') {
          git branch: 'master', url: 'https://github.com/buiminh-afk/devops-bootcamp-todolist-frontend.git'
        }

        sh '''
          echo "=== Workspace ==="
          pwd
          find . -maxdepth 2 -type d | sort
        '''
      }
    }

    stage('Build and push images') {
      steps {
        withCredentials([
          usernamePassword(credentialsId: 'dockerhub-credentials', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')
        ]) {
          script {
            def tag = params.IMAGE_TAG?.trim() ? params.IMAGE_TAG : env.BUILD_NUMBER
            env.IMAGE_TAG = tag

            sh '''
              set -e
              echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
              docker build -t "$DOCKER_USER/vntechies-todolist-backend:$IMAGE_TAG" ./backend
              docker build -t "$DOCKER_USER/vntechies-todolist-frontend:$IMAGE_TAG" --build-arg NEXT_PUBLIC_API_URL=http://127.0.0.1:5000/api ./frontend
              docker push "$DOCKER_USER/vntechies-todolist-backend:$IMAGE_TAG"
              docker push "$DOCKER_USER/vntechies-todolist-frontend:$IMAGE_TAG"
            '''
          }
        }
      }
    }

    stage('Deploy to Application EC2 (dev)') {
      steps {
        withCredentials([
          sshUserPrivateKey(
            credentialsId: 'application-ec2-ssh',
            keyFileVariable: 'SSH_KEY',
            usernameVariable: 'SSH_USER'
          ),
          string(
            credentialsId: 'application-ec2-host',
            variable: 'APP_HOST'
          ),
          usernamePassword(
            credentialsId: 'todo-dev-db-credentials',
            usernameVariable: 'DB_USER',
            passwordVariable: 'DB_PASSWORD'
          ),
          usernamePassword(
            credentialsId: 'dockerhub-credentials',
            usernameVariable: 'DOCKER_USER',
            passwordVariable: 'DOCKER_TOKEN'
          )
        ]) {
          sh '''
    #!/usr/bin/env bash
    set -euxo pipefail

    echo "=== Preparing deploy script ==="
    pwd
    ls -la
    ls -la scripts/

    test -f scripts/deploy-dev.sh
    chmod +x scripts/deploy-dev.sh

    echo "=== Testing SSH connection ==="
    ssh \
      -i "$SSH_KEY" \
      -o StrictHostKeyChecking=no \
      -o UserKnownHostsFile=/dev/null \
      "$SSH_USER@$APP_HOST" \
      'hostname && whoami && docker --version && docker compose version'

    echo "=== Copying deploy script ==="
    scp \
      -i "$SSH_KEY" \
      -o StrictHostKeyChecking=no \
      -o UserKnownHostsFile=/dev/null \
      scripts/deploy-dev.sh \
      "$SSH_USER@$APP_HOST:/tmp/deploy-dev.sh"

    echo "=== Running remote deployment ==="
    ssh \
      -i "$SSH_KEY" \
      -o StrictHostKeyChecking=no \
      -o UserKnownHostsFile=/dev/null \
      "$SSH_USER@$APP_HOST" \
      bash -s -- \
        "$IMAGE_TAG" \
        "$DB_HOST" \
        "$DB_NAME" \
        "$DB_USER" \
        "$DB_PASSWORD" \
        "$BACKEND_PORT" \
        "$FRONTEND_PORT" \
        "$NEXT_PUBLIC_API_URL" \
        "$DOCKER_USER" <<'REMOTE'
    set -euxo pipefail

    IMAGE_TAG="$1"
    DB_HOST="$2"
    DB_NAME="$3"
    DB_USER="$4"
    DB_PASSWORD="$5"
    BACKEND_PORT="$6"
    FRONTEND_PORT="$7"
    NEXT_PUBLIC_API_URL="$8"
    DOCKER_USER="$9"

    hostname
    whoami

    chmod +x /tmp/deploy-dev.sh

    bash -x /tmp/deploy-dev.sh \
      /opt/todolist/dev \
      "$IMAGE_TAG" \
      "$DB_HOST" \
      5432 \
      "$DB_NAME" \
      "$DB_USER" \
      "$DB_PASSWORD" \
      "$BACKEND_PORT" \
      "$FRONTEND_PORT" \
      "$NEXT_PUBLIC_API_URL" \
      "$DOCKER_USER"
    REMOTE
          '''
        }
      }
    }
  }

  post {
    always {
      sh 'docker logout || true'
    }
  }
}
