pipeline {
  agent any

  parameters {
    string(
      name: 'IMAGE_TAG',
      defaultValue: '',
      description: 'Image tag đã build và pass ở dev'
    )

    string(
      name: 'DB_HOST',
      defaultValue: '10.0.2.234',
      description: 'Private IP/DNS của PostgreSQL EC2'
    )

    string(
      name: 'DB_NAME',
      defaultValue: 'todo_prod',
      description: 'Production database name'
    )

    string(
      name: 'KUBE_CONTEXT',
      defaultValue: 'kind-todo-prod',
      description: 'kubectl context'
    )

    string(
      name: 'CLUSTER_NAME',
      defaultValue: 'todo-prod',
      description: 'Kind cluster name'
    )
  }

  environment {
    BACKEND_IMAGE  = 'buiminh03/vntechies-todolist-backend'
    FRONTEND_IMAGE = 'buiminh03/vntechies-todolist-frontend'
    APP_HOST = '10.0.1.178'
    DB_USER = 'todo_prod_user'
    DB_PASSWORD = 'ProdStrongPassword123!'
  }

  stages {
    stage('Checkout') {
      steps {
        deleteDir()
        checkout scm

        sh '''
          set -eu

          echo "=== Workspace ==="
          pwd
          find . -maxdepth 2 -type d | sort

          test -f scripts/deploy-prod.sh
          test -d k8s-prod
        '''
      }
    }

    stage('Validate Parameters') {
      steps {
        script {
          if (!params.IMAGE_TAG?.trim()) {
            error('IMAGE_TAG is required. Enter the image tag that passed dev, for example 23.')
          }
        }

        sh '''
          set -eu

          test -n "${IMAGE_TAG:-}" || {
            echo "ERROR: IMAGE_TAG is required"
            exit 1
          }

          test -n "${DB_HOST:-}"
          test -n "${DB_NAME:-}"
          test -n "${KUBE_CONTEXT:-}"
          test -n "${CLUSTER_NAME:-}"

          echo "Deploying image tag: $IMAGE_TAG"
          echo "Database host: $DB_HOST"
          echo "Database name: $DB_NAME"
          echo "Kubernetes context: $KUBE_CONTEXT"
          echo "Kind cluster: $CLUSTER_NAME"
        '''
      }
    }

    stage('Approval') {
      steps {
        timeout(time: 15, unit: 'MINUTES') {
          input message: "Deploy image ${params.IMAGE_TAG} to production?"
        }
      }
    }

    stage('Deploy to Application EC2 (prod)') {
      steps {
        withCredentials([
          sshUserPrivateKey(
            credentialsId: 'application-ec2-ssh',
            keyFileVariable: 'SSH_KEY',
            usernameVariable: 'SSH_USER'
          ),

          usernamePassword(
            credentialsId: 'dockerhub-credentials',
            usernameVariable: 'DOCKER_USER',
            passwordVariable: 'DOCKER_PASS'
          )
        ]) {
          sh '''
            set -euo pipefail

            echo "=== Preparing prod deploy script ==="
            ls -l scripts/deploy-prod.sh
            chmod +x scripts/deploy-prod.sh

            echo "=== Copy deploy script ==="
            scp \
              -i "$SSH_KEY" \
              -o StrictHostKeyChecking=no \
              -o UserKnownHostsFile=/dev/null \
              scripts/deploy-prod.sh \
              "$SSH_USER@$APP_HOST:/tmp/deploy-prod.sh"

            echo "=== Prepare remote manifests directory ==="
            ssh \
              -i "$SSH_KEY" \
              -o StrictHostKeyChecking=no \
              -o UserKnownHostsFile=/dev/null \
              "$SSH_USER@$APP_HOST" \
              "set -euxo pipefail; mkdir -p /opt/todolist/prod/k8s && rm -rf /opt/todolist/prod/k8s/*"

            echo "=== Copy Kubernetes manifests ==="
            scp \
              -i "$SSH_KEY" \
              -o StrictHostKeyChecking=no \
              -o UserKnownHostsFile=/dev/null \
              -r k8s-prod/. \
              "$SSH_USER@$APP_HOST:/opt/todolist/prod/k8s/"

            echo "=== Run production deployment ==="
            ssh \
              -i "$SSH_KEY" \
              -o StrictHostKeyChecking=no \
              -o UserKnownHostsFile=/dev/null \
              "$SSH_USER@$APP_HOST" \
              "set -euxo pipefail; chmod +x /tmp/deploy-prod.sh; bash /tmp/deploy-prod.sh /opt/todolist/prod/k8s '$IMAGE_TAG' '$DB_HOST' '5432' '$DB_NAME' '$DB_USER' '$DB_PASSWORD' '$KUBE_CONTEXT' '$CLUSTER_NAME' '$DOCKER_USER'"
          '''
        }
      }
    }

    stage('Verify Production Images') {
      steps {
        withCredentials([
          usernamePassword(
            credentialsId: 'dockerhub-credentials',
            usernameVariable: 'DOCKER_USER',
            passwordVariable: 'DOCKER_PASS'
          )
        ]) {
          sh '''
            #!/usr/bin/env bash
            set -euo pipefail

            echo "$DOCKER_PASS" |
              docker login -u "$DOCKER_USER" --password-stdin

            echo "Verifying backend image..."
            docker manifest inspect \
              "$BACKEND_IMAGE:$IMAGE_TAG" >/dev/null

            echo "Verifying frontend image..."
            docker manifest inspect \
              "$FRONTEND_IMAGE:$IMAGE_TAG" >/dev/null

            echo "Both production images exist:"
            echo "- $BACKEND_IMAGE:$IMAGE_TAG"
            echo "- $FRONTEND_IMAGE:$IMAGE_TAG"
          '''
        }
      }
    }
  }
}