pipeline {
  agent any

  parameters {
    string(
      name: 'IMAGE_TAG',
      defaultValue: '',
      description: 'Image tag đã build và pass ở dev'
    )

    string(
      name: 'DB_HOST',
      defaultValue: '10.0.2.234',
      description: 'Private IP/DNS của PostgreSQL EC2'
    )

    string(
      name: 'DB_NAME',
      defaultValue: 'todo_prod',
      description: 'Production database name'
    )

    string(
      name: 'KUBE_CONTEXT',
      defaultValue: 'kind-todo-prod',
      description: 'kubectl context'
    )

    string(
      name: 'CLUSTER_NAME',
      defaultValue: 'todo-prod',
      description: 'Kind cluster name'
    )
  }

  environment {
    BACKEND_IMAGE  = 'buiminh03/vntechies-todolist-backend'
    FRONTEND_IMAGE = 'buiminh03/vntechies-todolist-frontend'
    APP_HOST = '10.0.1.178'
    DB_USER = 'todo_prod_user'
  }

  stages {
    stage('Checkout') {
      steps {
        deleteDir()
        checkout scm

        sh '''
          #!/usr/bin/env bash
          set -eu

          echo "=== Workspace ==="
          pwd

          echo "=== Kubernetes production files ==="
          find k8s-prod -maxdepth 3 -type f -print | sort

          test -f scripts/deploy-prod.sh || {
            echo "ERROR: scripts/deploy-prod.sh not found"
            exit 1
          }

          test -f k8s-prod/kind-config.yaml || {
            echo "ERROR: k8s-prod/kind-config.yaml not found"
            exit 1
          }
        '''
      }
    }

    stage('Validate Parameters') {
      steps {
        script {
          if (!params.IMAGE_TAG?.trim()) {
            error('IMAGE_TAG is required. Enter the image tag that passed dev, for example 23.')
          }
        }

        sh '''
          set -eu

          test -n "${IMAGE_TAG:-}" || {
            echo "ERROR: IMAGE_TAG is required"
            exit 1
          }

          test -n "${DB_HOST:-}"
          test -n "${DB_NAME:-}"
          test -n "${KUBE_CONTEXT:-}"
          test -n "${CLUSTER_NAME:-}"

          echo "Deploying image tag: $IMAGE_TAG"
          echo "Database host: $DB_HOST"
          echo "Database name: $DB_NAME"
          echo "Kubernetes context: $KUBE_CONTEXT"
          echo "Kind cluster: $CLUSTER_NAME"
        '''
      }
    }

    stage('Approval') {
      steps {
        timeout(time: 15, unit: 'MINUTES') {
          input message: "Deploy image ${params.IMAGE_TAG} to production?"
        }
      }
    }

    stage('Deploy to Application EC2 (prod)') {
      steps {
        withCredentials([
          sshUserPrivateKey(
            credentialsId: 'application-ec2-ssh',
            keyFileVariable: 'SSH_KEY',
            usernameVariable: 'SSH_USER'
          ),

          usernamePassword(
            credentialsId: 'dockerhub-credentials',
            usernameVariable: 'DOCKER_USER',
            passwordVariable: 'DOCKER_PASS'
          ),

          string(
            credentialsId: 'prod-postgres-password',
            variable: 'DB_PASSWORD'
          )
        ]) {
          sh '''
            #!/usr/bin/env bash
            set +x
            set -euo pipefail

            echo "=== Preparing prod deploy script ==="
            ls -l scripts/deploy-prod.sh
            chmod +x scripts/deploy-prod.sh

            echo "=== Copy deploy script ==="
            scp \
              -i "$SSH_KEY" \
              -o StrictHostKeyChecking=no \
              -o UserKnownHostsFile=/dev/null \
              scripts/deploy-prod.sh \
              "$SSH_USER@$APP_HOST:/tmp/deploy-prod.sh"

            echo "=== Prepare remote manifests directory ==="
            ssh \
              -i "$SSH_KEY" \
              -o StrictHostKeyChecking=no \
              -o UserKnownHostsFile=/dev/null \
              "$SSH_USER@$APP_HOST" \
              'set -euo pipefail
               mkdir -p /opt/todolist/prod/k8s
               find /opt/todolist/prod/k8s -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +'

            echo "=== Copy Kubernetes manifests ==="
            scp \
              -i "$SSH_KEY" \
              -o StrictHostKeyChecking=no \
              -o UserKnownHostsFile=/dev/null \
              -r k8s-prod/. \
              "$SSH_USER@$APP_HOST:/opt/todolist/prod/k8s/"

            echo "=== Verify copied manifests ==="
            ssh \
              -i "$SSH_KEY" \
              -o StrictHostKeyChecking=no \
              -o UserKnownHostsFile=/dev/null \
              "$SSH_USER@$APP_HOST" \
              'set -euo pipefail
               echo "Files copied to remote:"
               find /opt/todolist/prod/k8s -maxdepth 3 -type f -print | sort
               test -f /opt/todolist/prod/k8s/kind-config.yaml || {
                 echo "ERROR: kind-config.yaml was not copied"
                 exit 1
               }'

            echo "=== Run production deployment ==="
            # Send the database password over SSH standard input. It must not be
            # embedded in the SSH command line or exposed by shell tracing.
            printf '%s' "$DB_PASSWORD" | ssh \
              -i "$SSH_KEY" \
              -o StrictHostKeyChecking=no \
              -o UserKnownHostsFile=/dev/null \
              "$SSH_USER@$APP_HOST" \
              "set -euo pipefail; DB_PASSWORD=\$(cat); export DB_PASSWORD; chmod +x /tmp/deploy-prod.sh; bash /tmp/deploy-prod.sh /opt/todolist/prod/k8s '$IMAGE_TAG' '$DB_HOST' '5432' '$DB_NAME' '$DB_USER' '' '$KUBE_CONTEXT' '$CLUSTER_NAME' '$DOCKER_USER'"
          '''
        }
      }
    }

    stage('Verify Production Images') {
      steps {
        withCredentials([
          usernamePassword(
            credentialsId: 'dockerhub-credentials',
            usernameVariable: 'DOCKER_USER',
            passwordVariable: 'DOCKER_PASS'
          )
        ]) {
          sh '''
            #!/usr/bin/env bash
            set -euo pipefail

            echo "$DOCKER_PASS" |
              docker login -u "$DOCKER_USER" --password-stdin

            echo "Verifying backend image..."
            docker manifest inspect \
              "$BACKEND_IMAGE:$IMAGE_TAG" >/dev/null

            echo "Verifying frontend image..."
            docker manifest inspect \
              "$FRONTEND_IMAGE:$IMAGE_TAG" >/dev/null

            echo "Both production images exist:"
            echo "- $BACKEND_IMAGE:$IMAGE_TAG"
            echo "- $FRONTEND_IMAGE:$IMAGE_TAG"
          '''
        }
      }
    }
  }
}
